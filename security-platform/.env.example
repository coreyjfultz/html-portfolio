# Copy to .env and fill in. Never commit .env.

# Your web address (DNS must point at this server). Used for the HTTPS certificate.
DOMAIN=app.yourcompany.com

# Time zone for schedules, timesheets, reminders and nightly backups.
TZ=America/New_York

# Optional: reading supplier-invoice PDFs/photos with Claude, and the help assistant.
ANTHROPIC_API_KEY=

# Backups (database + photos/invoices) every night inside the data volume.
# Backup time, folder, password and off-site storage are set in Settings → Backup & data.
# These override the in-app values (handy for restoring onto a new server; see deploy/GO-LIVE.md):
# BACKUP_HOUR=2
# BACKUP_DIR=/backups
# BACKUP_PASSPHRASE=
# OFFSITE_ENDPOINT= OFFSITE_BUCKET= OFFSITE_PREFIX=secureops OFFSITE_KEY_ID= OFFSITE_SECRET=
# Optional continuous database backup (deploy/docker-compose.litestream.yml):
# LITESTREAM_BUCKET= LITESTREAM_ENDPOINT= LITESTREAM_REGION= LITESTREAM_ACCESS_KEY_ID= LITESTREAM_SECRET_ACCESS_KEY=
# Without a backup password, backups leave out the encryption key unless this is 1.
BACKUP_INCLUDE_KEY=0

# Optional relay server for in-app calls (see deploy/docker-compose.turn.yml).
# TURN_SECRET=
# TURN_URLS=turn:app.yourcompany.com:3478?transport=udp,turn:app.yourcompany.com:3478?transport=tcp

# Everything else (email, Twilio, Stripe, QuickBooks, tracking, maps) is set up inside the app
# under Settings. These optional variables override the in-app values:
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= MAIL_FROM=
# TWILIO_ACCOUNT_SID= TWILIO_AUTH_TOKEN= TWILIO_FROM=
# STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET=
# QBO_CLIENT_ID= QBO_CLIENT_SECRET=
# SAMSARA_API_TOKEN= GOOGLE_MAPS_KEY=
